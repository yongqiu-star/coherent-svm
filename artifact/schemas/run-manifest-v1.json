{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/coherent-svm/run-manifest-v1.json",
  "title": "Coherent SVM public run manifest",
  "type": "object",
  "required": [
    "schema",
    "config_id",
    "config_sha256",
    "source",
    "library_sha256",
    "dataset_id",
    "python",
    "platform_system",
    "platform_machine"
  ],
  "properties": {
    "schema": {"const": "coherent-svm-run-manifest-v1"},
    "config_id": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": ["revision", "dirty"],
      "properties": {
        "revision": {"type": "string"},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "library_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_id": {"type": "string"},
    "python": {"type": "string"},
    "platform_system": {"type": "string"},
    "platform_machine": {"type": "string"}
  },
  "additionalProperties": false
}


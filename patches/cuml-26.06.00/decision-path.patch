 #include <selection/kselection.cuh>
 #include <stdlib.h>
+#include <type_traits>
 
 namespace ML {
 namespace SVM {
 
+template <typename math_t>
+__device__ __forceinline__ math_t smo_fast_divide(math_t numerator, math_t denominator)
+{
+  if constexpr (std::is_same_v<math_t, float>) {
+    return __fdividef(numerator, denominator);
+  } else {
+    return numerator / denominator;
+  }
+}
+
+template <typename math_t, int ITEMS_PER_THREAD>
+__device__ __forceinline__ math_t smo_load_register_item(
+  const math_t (&values)[ITEMS_PER_THREAD], int selected)
+{
+  math_t value = math_t{0};
+#pragma unroll
+  for (int item = 0; item < ITEMS_PER_THREAD; ++item) {
+    if (selected == item) { value = values[item]; }
+  }
+  return value;
+}

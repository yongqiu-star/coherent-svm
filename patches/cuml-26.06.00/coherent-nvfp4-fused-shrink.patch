+
+template <typename math_t, int TPB = 256>
+CUML_KERNEL void compute_kkt_bounds_stage1(const math_t* __restrict__ alpha,
+                                           const math_t* __restrict__ y,
+                                           const math_t* __restrict__ C_vec,
+                                           const math_t* __restrict__ f,
+                                           int n,
+                                           math_t* __restrict__ block_min_up,
+                                           math_t* __restrict__ block_max_low)
+{
+  using BlockReduce = cub::BlockReduce<math_t, TPB>;
+  __shared__ typename BlockReduce::TempStorage temp_up;
+  __shared__ typename BlockReduce::TempStorage temp_low;
+
+  math_t local_min_up  = INFINITY;
+  math_t local_max_low = -INFINITY;
+  for (int i = blockIdx.x * TPB + threadIdx.x; i < n; i += gridDim.x * TPB) {
+    const math_t Ci = C_vec[i];
+    if (Ci > math_t{0}) {
+      const math_t ai = alpha[i];
+      const math_t yi = y[i];
+      const math_t fi = f[i];
+      if (in_upper(ai, yi, Ci) && fi < local_min_up) { local_min_up = fi; }
+      if (in_lower(ai, yi, Ci) && fi > local_max_low) { local_max_low = fi; }
+    }
+  }
+  const math_t min_up = BlockReduce(temp_up).Reduce(local_min_up, cuda::minimum{});
+  const math_t max_low = BlockReduce(temp_low).Reduce(local_max_low, cuda::maximum{});
+  if (threadIdx.x == 0) {
+    block_min_up[blockIdx.x]  = min_up;
+    block_max_low[blockIdx.x] = max_low;
+  }
+}
+
+template <typename math_t, int TPB = 256>
+CUML_KERNEL void compute_kkt_bounds_stage2(const math_t* __restrict__ block_min_up,
+                                           const math_t* __restrict__ block_max_low,
+                                           int num_blocks,
+                                           math_t* __restrict__ out_bounds)
+{
+  using BlockReduce = cub::BlockReduce<math_t, TPB>;
+  __shared__ typename BlockReduce::TempStorage temp_up;
+  __shared__ typename BlockReduce::TempStorage temp_low;
+
+  const math_t local_min = threadIdx.x < num_blocks ? block_min_up[threadIdx.x] : INFINITY;
+  const math_t local_max = threadIdx.x < num_blocks ? block_max_low[threadIdx.x] : -INFINITY;
+  const math_t min_up    = BlockReduce(temp_up).Reduce(local_min, cuda::minimum{});
+  const math_t max_low   = BlockReduce(temp_low).Reduce(local_max, cuda::maximum{});
+  if (threadIdx.x == 0) {
+    out_bounds[0] = min_up;
+    out_bounds[1] = max_low;
+  }
+}
+
+template <typename math_t>
+CUML_KERNEL void build_keep_mask(const math_t* __restrict__ alpha,
+                                 const math_t* __restrict__ y,
+                                 const math_t* __restrict__ C_vec,
+                                 const math_t* __restrict__ f,
+                                 int n,
+                                 math_t f_min_up,
+                                 math_t f_max_low,
+                                 math_t margin,
+                                 std::uint8_t* __restrict__ keep_mask)
+{
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
+    const math_t Ci = C_vec[i];
+    bool keep       = false;
+    if (Ci > math_t{0}) {
+      const math_t ai = alpha[i];
+      const math_t yi = y[i];
+      const math_t fi = f[i];
+      keep = (in_upper(ai, yi, Ci) && fi <= f_max_low + margin) ||
+             (in_lower(ai, yi, Ci) && fi >= f_min_up - margin);
+    }
+    keep_mask[i] = keep ? std::uint8_t{1} : std::uint8_t{0};
+  }
+}
+
+template <typename math_t>
+CUML_KERNEL void gather_compact_state(const int* __restrict__ selected_local_idx,
+                                      const int* __restrict__ cur_orig_idx,
+                                      const math_t* __restrict__ src_y,
+                                      const math_t* __restrict__ src_alpha,
+                                      const math_t* __restrict__ src_f,
+                                      const math_t* __restrict__ src_C,
+                                      int new_real_rows,
+                                      int new_padded_rows,
+                                      int* __restrict__ dst_orig_idx,
+                                      math_t* __restrict__ dst_y,
+                                      math_t* __restrict__ dst_alpha,
+                                      math_t* __restrict__ dst_f,
+                                      math_t* __restrict__ dst_C)
+{
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < new_padded_rows;
+       i += gridDim.x * blockDim.x) {
+    if (i < new_real_rows) {
+      const int src_i = selected_local_idx[i];
+      dst_orig_idx[i] = cur_orig_idx != nullptr ? cur_orig_idx[src_i] : src_i;
+      dst_y[i]        = src_y[src_i];
+      dst_alpha[i]    = src_alpha[src_i];
+      dst_f[i]        = src_f[src_i];
+      dst_C[i]        = src_C[src_i];
+    } else {
+      dst_f[i] = math_t{0};
+    }
+  }
+}
+
+template <typename math_t>
+CUML_KERNEL void scatter_shrunk_alpha(const int* __restrict__ orig_idx,
+                                      const math_t* __restrict__ shrunk_alpha,
+                                      int n,
+                                      math_t* __restrict__ full_alpha)
+{
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
+    full_alpha[orig_idx[i]] = shrunk_alpha[i];
+  }
+}
+
+template <typename math_t>
+CUML_KERNEL void scatter_shrunk_f(const int* __restrict__ orig_idx,
+                                  const math_t* __restrict__ shrunk_f,
+                                  int n,
+                                  math_t* __restrict__ full_f)
+{
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
+    full_f[orig_idx[i]] = shrunk_f[i];
+  }
+}
+
+template <typename math_t>
+CUML_KERNEL void compute_signed_delta_and_flag(const math_t* __restrict__ alpha_now,
+                                               const math_t* __restrict__ alpha_ref,
+                                               const math_t* __restrict__ y,
+                                               int n,
+                                               math_t* __restrict__ signed_delta,
+                                               std::uint8_t* __restrict__ changed_mask)
+{
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
+    const math_t d  = (alpha_now[i] - alpha_ref[i]) * y[i];
+    signed_delta[i] = d;
+    changed_mask[i] = (d != math_t{0}) ? std::uint8_t{1} : std::uint8_t{0};
+  }
+}
+
+template <typename math_t>
+CUML_KERNEL void gather_changed_delta(const int* __restrict__ changed_idx,
+                                      const math_t* __restrict__ signed_delta,
+                                      int n,
+                                      math_t* __restrict__ out_delta)
+{
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
+    out_delta[i] = signed_delta[changed_idx[i]];
+  }
+}

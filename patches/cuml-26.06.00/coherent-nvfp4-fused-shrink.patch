+template <typename math_t>
+__device__ __forceinline__ math_t smo_fast_divide(math_t numerator, math_t denominator)
+{
+  if constexpr (std::is_same_v<math_t, float>) {
+    return __fdividef(numerator, denominator);
+  } else {
+    return numerator / denominator;
+  }
+}

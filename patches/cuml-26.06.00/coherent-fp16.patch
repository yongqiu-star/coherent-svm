diff --git a/cpp/src/svm/smoblocksolve.cuh b/cpp/src/svm/smoblocksolve.cuh
index 6d05c88..01b8946 100644
--- a/cpp/src/svm/smoblocksolve.cuh
+++ b/cpp/src/svm/smoblocksolve.cuh
@@ -270,5 +270,169 @@ CUML_KERNEL __launch_bounds__(WSIZE) void SmoBlockSolve(math_t* y_array,
   // f is recalculated in f_update, therefore we do not need to save that
   return_buff[1] = n_iter;
 }
+
+/** Exact thread-coarsened SMO with the same pair-update order as SmoBlockSolve. */
+template <typename math_t, int TPB, int ITEMS_PER_THREAD>
+CUML_KERNEL __launch_bounds__(TPB) void SmoBlockSolveCoarsened(math_t* y_array,
+                                                               int n_train,
+                                                               math_t* alpha,
+                                                               int n_ws,
+                                                               math_t* delta_alpha,
+                                                               math_t* f_array,
+                                                               const math_t* kernel,
+                                                               const int* ws_idx,
+                                                               const math_t* C_vec,
+                                                               math_t eps,
+                                                               math_t* return_buff,
+                                                               int max_iter = 10000,
+                                                               SvmType svmType = C_SVC)
+{
+  static_assert(TPB * ITEMS_PER_THREAD == 1024,
+                "coarsened variants target the 1024-entry SMO working set");
+  using Pair             = MLCommon::Selection::KVPair<math_t, int>;
+  using BlockReducePair  = cub::BlockReduce<Pair, TPB>;
+  using BlockReduceFloat = cub::BlockReduce<math_t, TPB>;
+  __shared__ union {
+    typename BlockReducePair::TempStorage pair;
+    typename BlockReduceFloat::TempStorage single;
+  } temp_storage;
+
+  constexpr math_t ETA_EPS = 1.0e-12;
+  __shared__ math_t f_u;
+  __shared__ math_t diff;
+  __shared__ math_t diff_end;
+  __shared__ math_t tmp_u;
+  __shared__ math_t tmp_l;
+  __shared__ int u;
+  __shared__ int l;
+  __shared__ math_t Kd[TPB * ITEMS_PER_THREAD];
+
+  const int tid = threadIdx.x;
+  math_t local_y[ITEMS_PER_THREAD];
+  math_t local_f[ITEMS_PER_THREAD];
+  math_t local_a[ITEMS_PER_THREAD];
+  math_t local_a_save[ITEMS_PER_THREAD];
+  math_t local_C[ITEMS_PER_THREAD];
+  math_t local_Kui[ITEMS_PER_THREAD];
+
+#pragma unroll
+  for (int item = 0; item < ITEMS_PER_THREAD; ++item) {
+    const int pos = tid + item * TPB;
+    if (pos < n_ws) {
+      const int idx      = ws_idx[pos];
+      local_y[item]      = y_array[idx];
+      local_f[item]      = f_array[idx];
+      local_a[item]      = alpha[idx];
+      local_a_save[item] = local_a[item];
+      local_C[item]      = C_vec[idx];
+      Kd[pos]            = kernel[static_cast<size_t>(pos) * n_ws + pos];
+    } else {
+      local_y[item]      = math_t{0};
+      local_f[item]      = math_t{0};
+      local_a[item]      = math_t{0};
+      local_a_save[item] = math_t{0};
+      local_C[item]      = math_t{0};
+      Kd[pos]            = math_t{0};
+    }
+  }
+  __syncthreads();
+
+  int n_iter = 0;
+  for (; n_iter < max_iter; ++n_iter) {
+    Pair upper_best{INFINITY, -1};
+#pragma unroll
+    for (int item = 0; item < ITEMS_PER_THREAD; ++item) {
+      const int pos = tid + item * TPB;
+      if (pos < n_ws && in_upper(local_a[item], local_y[item], local_C[item]) &&
+          local_f[item] < upper_best.val) {
+        upper_best = Pair{local_f[item], pos};
+      }
+    }
+    Pair result = BlockReducePair(temp_storage.pair).Reduce(upper_best, cuda::minimum{});
+    if (tid == 0) {
+      f_u = result.val;
+      u   = result.key;
+    }
+    __syncthreads();
+
+    math_t lower_max = -INFINITY;
+#pragma unroll
+    for (int item = 0; item < ITEMS_PER_THREAD; ++item) {
+      const int pos = tid + item * TPB;
+      if (pos < n_ws) {
+        local_Kui[item] = kernel[static_cast<size_t>(u) * n_ws + pos];
+        if (in_lower(local_a[item], local_y[item], local_C[item])) {
+          lower_max = max(lower_max, local_f[item]);
+        }
+      }
+    }
+    const math_t f_max = BlockReduceFloat(temp_storage.single).Reduce(lower_max, cuda::maximum{});
+    if (tid == 0) {
+      diff = f_max - f_u;
+      if (n_iter == 0) {
+        return_buff[0] = diff;
+        diff_end       = max(eps, math_t{0.1} * diff);
+      }
+    }
+    __syncthreads();
+    if (diff < diff_end) { break; }
+
+    Pair lower_best{-INFINITY, -1};
+#pragma unroll
+    for (int item = 0; item < ITEMS_PER_THREAD; ++item) {
+      const int pos = tid + item * TPB;
+      if (pos < n_ws && f_u < local_f[item] &&
+          in_lower(local_a[item], local_y[item], local_C[item])) {
+        const math_t eta = max(Kd[pos] + Kd[u] - math_t{2} * local_Kui[item], ETA_EPS);
+        const math_t residual = f_u - local_f[item];
+        const math_t score    = residual * residual / eta;
+        if (score > lower_best.val) { lower_best = Pair{score, pos}; }
+      }
+    }
+    result = BlockReducePair(temp_storage.pair).Reduce(lower_best, cuda::maximum{});
+    if (tid == 0) { l = result.key; }
+    __syncthreads();
+
+#pragma unroll
+    for (int item = 0; item < ITEMS_PER_THREAD; ++item) {
+      const int pos = tid + item * TPB;
+      if (pos == u) {
+        tmp_u = local_y[item] > 0 ? local_C[item] - local_a[item] : local_a[item];
+      }
+      if (pos == l) {
+        const math_t eta = max(Kd[u] + Kd[l] - math_t{2} * local_Kui[item], ETA_EPS);
+        tmp_l = local_y[item] > 0 ? local_a[item] : local_C[item] - local_a[item];
+        tmp_l = min(tmp_l, (local_f[item] - f_u) / eta);
+      }
+    }
+    __syncthreads();
+    const math_t q = min(tmp_u, tmp_l);
+
+#pragma unroll
+    for (int item = 0; item < ITEMS_PER_THREAD; ++item) {
+      const int pos = tid + item * TPB;
+      if (pos < n_ws) {
+        const math_t Kli = kernel[static_cast<size_t>(l) * n_ws + pos];
+        if (pos == u) { local_a[item] += q * local_y[item]; }
+        if (pos == l) { local_a[item] -= q * local_y[item]; }
+        local_f[item] += q * (local_Kui[item] - Kli);
+      }
+    }
+    if (q == 0) { break; }
+  }
+
+#pragma unroll
+  for (int item = 0; item < ITEMS_PER_THREAD; ++item) {
+    const int pos = tid + item * TPB;
+    if (pos < n_ws) {
+      const int idx    = ws_idx[pos];
+      alpha[idx]       = local_a[item];
+      delta_alpha[pos] = (local_a[item] - local_a_save[item]) * local_y[item];
+    }
+  }
+  if (tid == 0) { return_buff[1] = n_iter; }
+  (void)n_train;
+  (void)svmType;
+}
 };  // end namespace SVM
 };  // end namespace ML
